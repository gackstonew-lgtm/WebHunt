# WebHunt Delta — Environment Variables Reference
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@host:5432/webhunt"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
SESSION_SECRET="your-32-char-minimum-random-secret"
ENCRYPTION_SECRET="your-32-char-minimum-random-secret"

# ---------------------------------------------------------------------------
# AI Gateway — LiteLLM (recommended) or OpenAI direct
# ---------------------------------------------------------------------------
# Option A: LiteLLM Gateway (recommended for multi-provider support)
# Deploy LiteLLM separately: https://github.com/BerriAI/litellm
# Railway one-click: https://railway.app/template/litellm
LITELLM_BASE_URL=https://your-litellm-deployment.railway.app
LITELLM_API_KEY=sk-your-litellm-virtual-key

# Option B: Direct OpenAI (no LiteLLM needed — just set OPENAI_API_KEY)
# OPENAI_API_KEY=sk-your-openai-key

# AI Model Configuration (used by WebHunt's gateway.ts)
AI_DEFAULT_MODEL=gpt-4o           # For proposal writing, strategy
AI_FAST_MODEL=gpt-4o-mini         # For analysis, classification, review
AI_REASONING_MODEL=gpt-4o         # For complex strategy/reasoning

# Token and cost limits
AI_MAX_TOKENS=4096
AI_MONTHLY_BUDGET_USD=50.00       # Informational — enforcement via LiteLLM budget limits

# ---------------------------------------------------------------------------
# Email (for mailto: / SMTP outreach)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your-smtp-password

# ---------------------------------------------------------------------------
# Payments (Kora)
# ---------------------------------------------------------------------------
KORA_API_KEY=your-kora-api-key
KORA_SECRET_KEY=your-kora-secret
KORA_WEBHOOK_SECRET=your-kora-webhook-secret

# ---------------------------------------------------------------------------
# External APIs (Radar sources)
# ---------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=your-google-places-key
YELP_API_KEY=your-yelp-key
FOURSQUARE_API_KEY=your-foursquare-key
ADZUNA_APP_ID=your-adzuna-id
ADZUNA_API_KEY=your-adzuna-key

# ---------------------------------------------------------------------------
# Vercel / Deployment
# ---------------------------------------------------------------------------
NEXTAUTH_URL=https://your-domain.vercel.app
NODE_ENV=production
