# ==============================================================================
# GACKS LEADS - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Neon PostgreSQL or any standard PostgreSQL instance)
# ------------------------------------------------------------------------------
# Example Neon connection string (pooled connection):
# DATABASE_URL="postgresql://username:password@ep-cool-frost-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 2. GOOGLE PLACES API KEY (Optional if using OSM or Demo provider)
# ------------------------------------------------------------------------------
# Get your key at: https://console.cloud.google.com/apis/credentials
# Enable "Places API (New)" or standard "Places API"
GOOGLE_PLACES_API_KEY=""

# ------------------------------------------------------------------------------
# 3. YELP FUSION API KEY (Optional)
# ------------------------------------------------------------------------------
# Get your free API key at: https://www.yelp.com/developers/v3/manage_app
YELP_API_KEY=""

# ------------------------------------------------------------------------------
# 4. DEFAULT SEARCH PROVIDER
# ------------------------------------------------------------------------------
# Options: "all" | "google" | "yelp" | "osm" | "demo"
# "demo" works out of the box with zero API keys.
# "osm" uses free OpenStreetMap Overpass API without an API key.
DEFAULT_PROVIDER="demo"

# ------------------------------------------------------------------------------
# 5. CACHE & RATE LIMITING
# ------------------------------------------------------------------------------
# Cache search results for 24 hours (86400 seconds) to avoid duplicate API billing
CACHE_TTL_SECONDS=86400
ENABLE_API_CACHE=true
