# ==============================================================================
# WEBHUNT - ENVIRONMENT CONFIGURATION (PRODUCTION REAL DATA)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (SQLite for local zero-config, PostgreSQL for production)
# ------------------------------------------------------------------------------
# Local SQLite default:
DATABASE_URL="file:./dev.db"
# Production Neon PostgreSQL example:
# DATABASE_URL="postgresql://username:password@ep-cool-frost-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. SECURITY & ENCRYPTION SECRETS (REQUIRED IN PRODUCTION)
# ------------------------------------------------------------------------------
# 32+ character random hex or base64 string for AES-256-GCM session tokens & OTP salting.
# Generate with: openssl rand -hex 32
ENCRYPTION_SECRET="super-secret-encryption-key-for-webhunt-sessions-min32chars"

# Initial admin account bootstrap password (Required on fresh production deployment)
WEBHUNT_ADMIN_BOOTSTRAP_PASSWORD="ChangeMeInProduction_Complex123!"

# Admin account email address
ADMIN_EMAIL="admin@webhunt.io"

# Canonical public base URL
NEXT_PUBLIC_APP_URL="https://webhunt.io"

# ------------------------------------------------------------------------------
# 3. TRANSACTIONAL EMAIL (RESEND)
# ------------------------------------------------------------------------------
# Resend API Key for OTP & password reset delivery
# Get key: https://resend.com/api-keys
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_FROM_NAME="WebHunt Security"

# ------------------------------------------------------------------------------
# 4. PHYSICAL BUSINESS DISCOVERY PROVIDERS
# ------------------------------------------------------------------------------
# OpenStreetMap Overpass (Free Worldwide, zero-key, active by default)
#
# Google Places API (Optional - active when key is supplied)
# Get key: https://console.cloud.google.com/apis/credentials (Enable Places API New)
GOOGLE_PLACES_API_KEY=""

# Yelp Fusion API (Optional - active when key is supplied)
# Get key: https://www.yelp.com/developers/v3/manage_app
YELP_API_KEY=""

# Foursquare Places API (Optional - active when key is supplied)
# Get key: https://location.foursquare.com/developer/
FOURSQUARE_API_KEY=""

# ------------------------------------------------------------------------------
# 5. REMOTE & JOB DISCOVERY PROVIDERS (Free & Unauthenticated by Default)
# ------------------------------------------------------------------------------
# Remotive Public API: Active (Free)
# Arbeitnow Job Board API: Active (Free)
# Himalayas Remote Jobs API: Active (Free)
# We Work Remotely Public RSS: Active (Free)
# Jobspresso Remote Feed: Active (Free)
# Remote OK Public API: Active (Free)
# Africa & Kenya Remote Discovery: Active (Free)

# ------------------------------------------------------------------------------
# 6. DEFAULT SEARCH PROVIDER
# ------------------------------------------------------------------------------
# Physical Options: "all" | "osm" | "google" | "yelp" | "foursquare"
# "osm" uses free OpenStreetMap Overpass API without requiring any API key.
DEFAULT_PROVIDER="all"

# ------------------------------------------------------------------------------
# 7. CACHE & RATE LIMITING
# ------------------------------------------------------------------------------
CACHE_TTL_SECONDS=86400
ENABLE_API_CACHE=true
